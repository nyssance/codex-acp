{
  "protocolVersion": 2,
  "info": {
    "name": "@nyssance/codex-acp-v2",
    "title": "Codex",
    "version": "<version>"
  },
  "capabilities": {
    "session": {
      "prompt": {
        "image": {},
        "embeddedContext": {}
      },
      "mcp": {
        "stdio": {},
        "http": {}
      },
      "delete": {},
      "additionalDirectories": {},
      "systemPrompt": {},
      "fork": {}
    },
    "auth": {
      "_meta": {
        "authStatus": {}
      }
    },
    "providers": {},
    "_meta": {
      "alwith": {
        "tools": {
          "version": 1
        },
        "turns": {
          "version": 2
        },
        "configRevision": {
          "version": 1
        }
      },
      "codex": {
        "shellCommand": {
          "version": 1
        },
        "sessionHistory": {
          "version": 2,
          "items": true,
          "modes": [
            "browse",
            "export"
          ]
        },
        "skills": true,
        "plugins": true,
        "pluginEnable": true,
        "account": true,
        "fuzzyFileSearch": true,
        "realtime": {
          "version": 1,
          "notificationMethod": "_codex/realtime/update"
        },
        "permissionProfiles": {
          "version": 1
        },
        "bedrock": {
          "version": 1
        },
        "hooks": {
          "version": 1,
          "listMethod": "_codex/hooks/list",
          "trustMethod": "_codex/hooks/trust"
        },
        "goal": {
          "version": 1,
          "controlMethod": "_session/goal",
          "actions": [
            "set",
            "pause",
            "resume",
            "clear"
          ]
        },
        "sessionList": {
          "version": 1
        },
        "archive": true,
        "rename": true,
        "readState": true,
        "providerCatalog": true,
        "forkAtTurn": true,
        "sessionLineage": true,
        "sessionRetry": {
          "version": 1
        },
        "seedHistory": true,
        "composerPredictions": true
      }
    }
  },
  "authMethods": [
    {
      "methodId": "api-key",
      "name": "API Key",
      "description": "Use an API key to authenticate",
      "_meta": {
        "api-key": {
          "provider": "openai"
        }
      },
      "type": "agent"
    },
    {
      "methodId": "chat-gpt",
      "name": "ChatGPT",
      "description": "Use ChatGPT to authenticate",
      "type": "agent"
    },
    {
      "methodId": "chat-gpt-device-code",
      "name": "ChatGPT (device code)",
      "description": "Sign in to ChatGPT by opening a verification page and entering a one-time code",
      "type": "agent"
    },
    {
      "methodId": "gateway",
      "name": "Custom model gateway",
      "description": "Use a custom gateway to authenticate and access models",
      "_meta": {
        "gateway": {
          "protocol": "openai",
          "restartRequired": "false"
        }
      },
      "type": "agent"
    }
  ],
  "_meta": {
    "steering": {
      "supported": true
    },
    "jetbrains": {
      "air": {
        "version": 1,
        "goal": {
          "version": 1,
          "controlMethod": "_session/goal",
          "actions": [
            "set",
            "pause",
            "resume",
            "clear"
          ]
        },
        "capabilities": [
          "sessionFailure",
          "agentFileChangeReport",
          "customInstructions",
          "nativeSubagentSessions",
          "asyncTasks",
          "recommendedValue"
        ]
      }
    }
  }
}
