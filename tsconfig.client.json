{
  // The `./client` entry: TypeScript ported from ALwith U. Declarations go to dist/types.
  "extends": "@nyssance/tsconfig",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "dist/types"
  },
  "include": ["src/client/index.ts", "src/import/index.ts"]
}
