{
    "name": "@nyssance/codex-acp-v2",
    "publishConfig": {
        "access": "public"
    },
    "version": "0.7.85",
    "description": "ACP adapter for Codex with ALwith client extensions",
    "main": "dist/index.js",
    "bin": {
        "codex-acp-v2": "dist/index.js"
    },
    "files": [
        "dist/index.js",
        "README.md",
        "LICENSE",
        "package.json",
        "dist/client.js",
        "dist/types",
        "docs/protocol.md",
        "licenses/alwith-protocol.txt",
        "docs/acp-client.md",
        "docs/session-state.md"
    ],
    "scripts": {
        "test:watch:unit": "bun --bun vitest watch --project=unit",
        "test:watch:native": "bun test --watch ./src/client/protocol",
        "test:canary": "bun test --preload ./src/__tests__/native-catalog-setup.ts --parallel --path-ignore-patterns='src/__tests__/integration/**' --path-ignore-patterns='src/__tests__/CodexACPAgent/e2e/**' --path-ignore-patterns='src/__tests__/CodexACPAgent/CodexAcpClient.test.ts' --path-ignore-patterns='src/__tests__/CodexACPAgent/mcp-session.test.ts' --path-ignore-patterns='src/__tests__/CodexACPAgent/mcp-config-merge.test.ts' src/__tests__ scripts src/client/protocol",
        "test:native": "bun test --parallel ./src/client/protocol",
        "prepublishOnly": "bun run build",
        "prepare": "bun run opencodex",
        "opencodex": "bun install --cwd opencodex --frozen-lockfile --ignore-scripts && bun opencodex/build.mjs",
        "build": "bun run opencodex && bun build.mjs && tsc -p tsconfig.client.json",
        "bundle:all": "bun run bundle:linux-x64 && bun run bundle:darwin-arm64 && bun run bundle:win-x64",
        "bundle:linux-x64": "bun build src/index.ts --minify --sourcemap --compile --target=bun-linux-x64-baseline --outfile dist/bin/codex-acp-v2-x64-linux",
        "bundle:darwin-arm64": "bun build src/index.ts --minify --sourcemap --compile --target=bun-darwin-arm64 --outfile dist/bin/codex-acp-v2-arm64-darwin",
        "bundle:win-x64": "bun build src/index.ts --minify --sourcemap --compile --target=bun-windows-x64-baseline --outfile dist/bin/codex-acp-v2-x64-windows.exe",
        "package:all": "bun run package:linux-x64 && bun run package:darwin-arm64 && bun run package:win-x64",
        "package:linux-x64": "cd dist/bin && zip codex-acp-v2-x64-linux.zip codex-acp-v2-x64-linux",
        "package:darwin-arm64": "cd dist/bin && zip codex-acp-v2-arm64-darwin.zip codex-acp-v2-arm64-darwin",
        "package:win-x64": "cd dist/bin && zip codex-acp-v2-x64-windows.zip codex-acp-v2-x64-windows.exe",
        "start": "bun src/index.ts",
        "example:simple-client": "bun examples/simple-client.ts",
        "example:steering": "bun examples/steering.ts",
        "example:steering:multistep": "bun examples/steering.ts",
        "generate-types": "codex app-server generate-ts --experimental --out src/app-server",
        "test": "bun run test:native && bun --bun vitest run --project=unit",
        "test:integration": "bun --bun vitest run --project=integration",
        "test:e2e": "bun run build && RUN_E2E_TESTS=true bun --bun vitest run --project=e2e",
        "test:watch": "bun run --parallel test:watch:native test:watch:unit",
        "codex-test": "bun .agents/skills/run-codex/scripts/run-codex-test.ts",
        "check": "bun check --no-script && bun check --no-script -p tsconfig.client-check.json && bun check --no-script -p examples/tsconfig.json",
        "typecheck": "bun check --no-script && bun check --no-script -p tsconfig.client-check.json && bun check --no-script -p examples/tsconfig.json",
        "test:app-server": "bun -e 'if(process.env.RUN_APP_SERVER_TESTS!==\"1\")throw new Error(\"Real app-server tests require explicit authorization and RUN_APP_SERVER_TESTS=1\")' && bun --bun vitest run --project=app-server src/__tests__/CodexACPAgent/CodexAcpClient.test.ts src/__tests__/CodexACPAgent/mcp-session.test.ts src/__tests__/CodexACPAgent/mcp-config-merge.test.ts"
    },
    "homepage": "https://github.com/nyssance/codex-acp#readme",
    "bugs": {
        "url": "https://github.com/nyssance/codex-acp/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nyssance/codex-acp.git"
    },
    "keywords": [],
    "author": "Agent Client Protocol",
    "license": "SEE LICENSE IN LICENSE",
    "type": "module",
    "devDependencies": {
        "@alwith/api": "^0.6.3",
        "@nyssance/ts7-lint": "^0.1.3",
        "@nyssance/tsconfig": "^0.1.2",
        "@types/bun": "^1.4.4",
        "@types/cross-spawn": "^6.0.6",
        "@types/ws": "^8.18.2",
        "ajv": "^8.20.0",
        "mcp-hello-world": "^1.1.2",
        "typescript": "^7.0.2",
        "vitest": "^5.1.1"
    },
    "dependencies": {
        "@agentclientprotocol/sdk": "^2.9.1",
        "@openai/codex": "^0.171.0",
        "cross-spawn": "^7.0.6",
        "diff": "^9.0.0",
        "effect": "^4.1.4",
        "open": "^11.0.4",
        "vscode-jsonrpc": "^10.0.0",
        "ws": "^8.23.0",
        "ws-transport": "npm:ws@8.23.0",
        "zod": "^4.6.7"
    },
    "exports": {
        ".": "./dist/index.js",
        "./client": {
            "types": "./dist/types/client/index.d.ts",
            "import": "./dist/client.js"
        }
    },
    "peerDependencies": {
        "@alwith/api": ">=0.5.4"
    }
}
