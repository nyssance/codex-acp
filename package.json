{
    "name": "@nyssance/codex-acp-v2",
    "publishConfig": {
        "access": "public"
    },
    "version": "0.7.43",
    "description": "ACP adapter for Codex with ALwith client extensions",
    "main": "dist/index.js",
    "bin": {
        "codex-acp-v2": "dist/index.js"
    },
    "files": [
        "dist/index.js",
        "README.md",
        "LICENSE",
        "package.json",
        "dist/client.js",
        "dist/types",
        "dist/import.js",
        "docs/protocol.md",
        "licenses/alwith-protocol.txt",
        "docs/acp-client.md",
        "docs/session-state.md"
    ],
    "scripts": {
        "prepublishOnly": "bun run build",
        "build": "bun build.mjs && tsc -p tsconfig.client.json",
        "bundle:all": "bun run bundle:linux-x64 && bun run bundle:linux-arm64 && bun run bundle:darwin-x64 && bun run bundle:darwin-arm64 && bun run bundle:win-x64 && bun run bundle:win-arm64",
        "bundle:linux-x64": "bun build src/index.ts --minify --sourcemap --compile --target=bun-linux-x64-baseline --outfile dist/bin/codex-acp-v2-x64-linux",
        "bundle:linux-arm64": "bun build src/index.ts --minify --sourcemap --compile --target=bun-linux-arm64 --outfile dist/bin/codex-acp-v2-arm64-linux",
        "bundle:darwin-x64": "bun build src/index.ts --minify --sourcemap --compile --target=bun-darwin-x64-baseline --outfile dist/bin/codex-acp-v2-x64-darwin",
        "bundle:darwin-arm64": "bun build src/index.ts --minify --sourcemap --compile --target=bun-darwin-arm64 --outfile dist/bin/codex-acp-v2-arm64-darwin",
        "bundle:win-x64": "bun build src/index.ts --minify --sourcemap --compile --target=bun-windows-x64-baseline --outfile dist/bin/codex-acp-v2-x64-windows.exe",
        "bundle:win-arm64": "bun build src/index.ts --minify --sourcemap --compile --target=bun-windows-arm64 --outfile dist/bin/codex-acp-v2-arm64-windows.exe",
        "package:all": "bun run package:linux-x64 && bun run package:linux-arm64 && bun run package:darwin-x64 && bun run package:darwin-arm64 && bun run package:win-x64 && bun run package:win-arm64",
        "package:linux-x64": "cd dist/bin && zip codex-acp-v2-x64-linux.zip codex-acp-v2-x64-linux",
        "package:linux-arm64": "cd dist/bin && zip codex-acp-v2-arm64-linux.zip codex-acp-v2-arm64-linux",
        "package:darwin-x64": "cd dist/bin && zip codex-acp-v2-x64-darwin.zip codex-acp-v2-x64-darwin",
        "package:darwin-arm64": "cd dist/bin && zip codex-acp-v2-arm64-darwin.zip codex-acp-v2-arm64-darwin",
        "package:win-x64": "cd dist/bin && zip codex-acp-v2-x64-windows.zip codex-acp-v2-x64-windows.exe",
        "package:win-arm64": "cd dist/bin && zip codex-acp-v2-arm64-windows.zip codex-acp-v2-arm64-windows.exe",
        "start": "bun src/index.ts",
        "example:simple-client": "bun examples/simple-client.ts",
        "example:steering": "bun examples/steering.ts",
        "example:steering:multistep": "bun examples/steering.ts",
        "generate-types": "codex app-server generate-ts --experimental --out src/app-server",
        "test": "vitest run --no-file-parallelism --retry=0 --exclude 'src/__tests__/integration/**' --exclude 'src/__tests__/CodexACPAgent/e2e/**' --exclude '**/node_modules/**' --exclude '**/.git/**' --exclude 'src/client/protocol/**' --exclude 'src/__tests__/CodexACPAgent/CodexAcpClient.test.ts' --exclude 'src/__tests__/CodexACPAgent/mcp-session.test.ts' --exclude 'src/__tests__/CodexACPAgent/mcp-config-merge.test.ts' && bun test src/client/protocol",
        "test:integration": "vitest run --no-file-parallelism --hookTimeout=30000 src/__tests__/integration",
        "test:e2e": "bun run build && RUN_E2E_TESTS=true vitest run --no-file-parallelism --retry=2 src/__tests__/CodexACPAgent/e2e",
        "test:watch": "vitest",
        "codex-test": "bun .agents/skills/run-codex/scripts/run-codex-test.ts",
        "check": "bun check --no-script && bun check --no-script -p tsconfig.client-check.json && bun check --no-script -p examples/tsconfig.json",
        "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.client-check.json && tsc --noEmit -p examples/tsconfig.json",
        "test:app-server": "bun -e 'if(process.env.RUN_APP_SERVER_TESTS!==\"1\")throw new Error(\"Real app-server tests require explicit authorization and RUN_APP_SERVER_TESTS=1\")' && vitest run --no-file-parallelism src/__tests__/CodexACPAgent/CodexAcpClient.test.ts src/__tests__/CodexACPAgent/mcp-session.test.ts src/__tests__/CodexACPAgent/mcp-config-merge.test.ts"
    },
    "homepage": "https://github.com/nyssance/codex-acp#readme",
    "bugs": {
        "url": "https://github.com/nyssance/codex-acp/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nyssance/codex-acp.git"
    },
    "keywords": [],
    "author": "Agent Client Protocol",
    "license": "SEE LICENSE IN LICENSE",
    "type": "module",
    "devDependencies": {
        "@alwith/api": "^0.5.4",
        "@nyssance/ts7-lint": "^0.1.3",
        "@types/bun": "^1.4.4",
        "@types/cross-spawn": "^6.0.6",
        "@types/ws": "^8.18.2",
        "ajv": "^8.20.0",
        "mcp-hello-world": "^1.1.2",
        "typescript": "^7.0.2",
        "vitest": "^5.0.5"
    },
    "dependencies": {
        "@agentclientprotocol/sdk": "^2.0.2",
        "@openai/codex": "^0.165.0",
        "cross-spawn": "^7.0.6",
        "diff": "^9.0.0",
        "open": "^11.0.4",
        "vscode-jsonrpc": "^10.0.0",
        "ws": "^8.22.0",
        "zod": "^4.6.7",
        "effect": "^4.0.6"
    },
    "exports": {
        ".": "./dist/index.js",
        "./client": {
            "types": "./dist/types/client/index.d.ts",
            "import": "./dist/client.js"
        },
        "./import": {
            "types": "./dist/types/import/index.d.ts",
            "import": "./dist/import.js"
        }
    },
    "peerDependencies": {
        "@alwith/api": ">=0.5.4"
    }
}
